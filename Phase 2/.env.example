# ============================================================
# Phase 2 — Additional Environment Variables
# Add these to your existing .env file (in Phase 1 root).
# NEVER commit your actual .env file.
# ============================================================

# Gemini API Key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (configurable without code changes)
GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum retries on transient Gemini API errors (default: 3)
GEMINI_MAX_RETRIES=3

# Gemini API timeout in seconds (default: 60)
GEMINI_TIMEOUT_SECONDS=60

# (Phase 1 vars below are shared — already in your .env)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json
