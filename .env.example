# ============================================================
# Phase 1 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# ============================================================

# Path to your Firebase service account JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/serviceAccount.json

# The Firestore document ID for your profile in the 'profiles' collection.
# Example: main, saish, primary
FIRESTORE_PROFILE_ID=main

# Maximum number of projects to display on the generated resume.
# All other projects remain stored in Firestore for future JD-matching use.
RESUME_PROJECT_LIMIT=3

# Path to the LaTeX master template (relative to project root).
# DO NOT change this unless you rename the template file.
LATEX_TEMPLATE_PATH=latex/resume_tex.tex

# Directory where generated .tex and .pdf files are written.
LATEX_OUTPUT_DIR=latex/output
