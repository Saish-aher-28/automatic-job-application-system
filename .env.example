# ============================================================
# Automatic Job Application System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── PHASE 1 — Core Engine Configuration ─────────────────────────────────────

# Path to your Firebase service account JSON file (for Python phases 1–4).
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/serviceAccount.json

# The Firestore document ID for your profile in the 'profiles' collection.
FIRESTORE_PROFILE_ID=main

# Maximum number of projects to display on the generated resume.
RESUME_PROJECT_LIMIT=3

# Path to the LaTeX master template (relative to project root). Do not change.
LATEX_TEMPLATE_PATH=latex/resume_tex.tex

# Directory where generated .tex and .pdf files are written.
LATEX_OUTPUT_DIR=latex/output

# ── PHASE 2-4 — Gemini AI Configuration ─────────────────────────────────────

# Your Gemini API key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# ── PHASE 5 — Go Backend Configuration ──────────────────────────────────────

# SECURITY CRITICAL: Controls the authentication posture of the Go backend.
#
# Set to "production" (or leave unset) for deployed/production environments.
#   → Firebase authentication is REQUIRED for every API request.
#   → SINGLE_USER_MODE is ignored — all unauthenticated requests return 401.
#
# Set to "development" for local development only.
#   → SINGLE_USER_MODE=true can be enabled to bypass auth (dev only).
#   → NEVER use development mode on a publicly accessible server.
ENVIRONMENT=development

# Dev bypass (ONLY honoured when ENVIRONMENT=development).
# Allows requests without a Firebase token, attributed to mock user "saish-aher-dev".
# Set to false to test real Firebase auth even during local development.
SINGLE_USER_MODE=true

# Go backend server port
PORT=8080

# Frontend URL for CORS policy.
# Must exactly match the origin your React app runs on.
FRONTEND_URL=http://localhost:5173

# Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── PHASE 5 — Firebase Frontend Configuration ────────────────────────────────
# These are PUBLIC keys used by the browser to initialise Firebase Auth.
# They do NOT grant backend access on their own — backend uses service account credentials.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── PHASE 5 — Production Deployment Notes ───────────────────────────────────
# For Docker / Lightsail deployment:
#   1. Set ENVIRONMENT=production
#   2. Do NOT set SINGLE_USER_MODE=true
#   3. Mount your Firestore service account JSON at /app/credentials.json
#   4. Set GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
#   5. See phase_5/lightsail_guide.md for full deployment instructions

# ── PHASE 6 — Job Discovery & Ingestion Configuration ───────────────────────

# Telegram API credentials (from https://my.telegram.org)
# Required only if you enable Telegram ingestion.
TELEGRAM_API_ID=your-telegram-api-id-here
TELEGRAM_API_HASH=your-telegram-api-hash-here

# Telegram session name (local session file path suffix)
TELEGRAM_SESSION=phase6_ingestion

# Configured Telegram channels to scan. Use comma-separated identifiers.
# Example: @reactjsjobs,@ml_job_opportunities,some_channel_id
TELEGRAM_SOURCES=@reactjsjobs

# Ingestion lookback configurations
MAX_MESSAGES=100
MAX_PAGES=5
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# Crawl intervals for site sources (in seconds)
CRAWL_INTERVAL=3600

