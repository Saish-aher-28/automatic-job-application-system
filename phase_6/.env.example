# ============================================================
# Phase 6 — Job Discovery & Ingestion Environment Variables
# ============================================================

# API Key for Gemini structured extraction
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Firebase credentials (defaults to parent path)
GOOGLE_APPLICATION_CREDENTIALS=../firebase-credentials/automatic-job-applicatio-7b237-firebase-adminsdk-fbsvc-a5c2b6fd17.json
FIRESTORE_PROFILE_ID=main

# Telegram API credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=phase6_ingestion

# Comma-separated channels or groups to monitor
TELEGRAM_SOURCES=@reactjsjobs

# Website sources — JSON array of crawl targets (leave empty to disable website crawling)
# Example: [{"name":"My Job Board","listing_url":"https://example.com/jobs","base_url":"https://example.com","enabled":true}]
WEBSITE_SOURCES=

# Ingestion settings
MAX_MESSAGES=100
MAX_PAGES=5
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CRAWL_INTERVAL=3600
DRY_RUN=false
